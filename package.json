{
  "name": "dioptra",
  "version": "0.0.3",
  "description": "Point it at any public GitHub repo, ask a question in plain English, get a grounded answer with file:line citations.",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "bin": {
    "dioptra": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "eval": "node --env-file-if-exists=.env --import tsx eval/run.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "cli",
    "github",
    "code-search",
    "developer-tools",
    "agent",
    "ai-agents",
    "anthropic"
  ],
  "author": "ironheart122 <moncy@getsignalinbox.com>",
  "license": "MIT",
  "homepage": "https://github.com/ironheart122/dioptra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironheart122/dioptra.git"
  },
  "bugs": {
    "url": "https://github.com/ironheart122/dioptra/issues"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "zod": "^4.6.6"
  }
}
